<h2 class="text-2xl font-bold text-brand mb-6">Recommended Projects</h2>

<div class="grid gap-6">
  <%= for recommendation <- @recommendations do %>
    <div class="bg-white border border-gray-200 rounded-2xl shadow-sm hover:shadow-md transition p-5">
      <!-- Project Name + GitHub Link -->
      <div class="flex items-center justify-between">
        <h3 class="text-lg font-semibold text-dark">
          <%= recommendation.project.full_name %>
        </h3>
        <.link
          href={recommendation.project.html_url}
          class="text-accent text-sm hover:underline"
          target="_blank"
        >
          View on GitHub
        </.link>
      </div>

      <!-- Description -->
      <p class="text-sm text-gray-600 mt-1">
        <%= recommendation.project.description %>
      </p>

      <!-- Topics -->
      <div class="flex flex-wrap gap-2 text-xs text-accent mt-2">
        <%= for topic <- recommendation.project.topics do %>
          <span class="bg-light border border-accent rounded px-2 py-1">
            <%= topic %>
          </span>
        <% end %>
      </div>

      <!-- Language, Issues, Watchers -->
      <div class="grid grid-cols-3 gap-4 text-sm text-gray-700 mt-4">
        <div>
          <span class="font-medium text-dark block mb-2">Language</span>
          <span class="inline-block text-white px-2 py-1 rounded text-xs"
                style={"background-color: #{recommendation.skill.color}"}>
            <%= recommendation.skill.name || "N/A" %>
          </span>
        </div>
        <div>
          <span class="font-medium text-dark block mb-2">Open Issues</span>
          <%= recommendation.project.open_issues_count %>
        </div>
        <div>
          <span class="font-medium text-dark block mb-2">Watchers</span>
          <%= recommendation.project.watchers_count %>
        </div>
      </div>

      <!-- Why Recommended -->
      <div class="mt-5 text-xs text-gray-500 italic">
        Recommended because you know
        <strong class={"text-[#{recommendation.skill.color}]"}>
          <%= recommendation.skill.name %>
        </strong>
      </div>
    </div>
  <% end %>
</div>
